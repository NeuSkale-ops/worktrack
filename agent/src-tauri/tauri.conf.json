{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkTrack",
  "version": "0.1.0",
  "identifier": "com.worktrack.agent",
  "build": { "beforeDevCommand": "npm run dev -- --port 1420", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "WorkTrack - visible time tracking", "width": 520, "height": 740, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "targets": ["nsis"], "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false } } }
}
