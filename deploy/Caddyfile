{
	admin off
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	auto_https disable_redirects
}

http://{$APP_DOMAIN}:8080 {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	handle_path /downloads/* {
		root * /srv/downloads
		@download_hidden path_regexp download_hidden (^|/)\.[^/]*
		respond @download_hidden 404
		header Cache-Control "public, max-age=31536000, immutable"
		@download_manifest path /macos/latest.json
		header @download_manifest Cache-Control "no-cache, max-age=0, must-revalidate"
		@installer path *.exe *.dmg
		header @installer Content-Disposition "attachment"
		file_server
	}
	@api path /api /api/* /healthz
	handle @api {
		reverse_proxy api:8080
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

http://:8081 {
	respond /healthz "ok" 200
}
