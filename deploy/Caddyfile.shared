{
	admin off
	auto_https off
	# The shared host proxy forwards client IPs over the private Docker network.
	servers {
		trusted_proxies static private_ranges
	}
}

http://:8080 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	# Missing installers and updates must be 404, never the React index page.
	handle_path /downloads/* {
		root * /srv/downloads
		@download_hidden path_regexp download_hidden (^|/)\.[^/]*
		respond @download_hidden 404
		@download_immutable not path /macos/latest.json
		header @download_immutable Cache-Control "public, max-age=31536000, immutable"
		@download_manifest path /macos/latest.json
		header @download_manifest Cache-Control "no-cache, max-age=0, must-revalidate"
		@installer path *.exe *.dmg
		header @installer Content-Disposition "attachment"
		file_server
	}
	handle_path /updates/* {
		root * /srv/updates
		@hidden path_regexp hidden (^|/)\.[^/]*
		respond @hidden 404
		@manifest path /windows/x86_64/latest.json
		header @manifest Cache-Control "no-cache, max-age=0, must-revalidate"
		@immutable path /windows/x86_64/releases/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@update_installer path *.exe
		header @update_installer Content-Disposition "attachment"
		file_server
	}
	# Staging validation never writes the production update directory.
	handle_path /updates-staging/* {
		root * /srv/updates-staging
		@staging_hidden path_regexp staging_hidden (^|/)\.[^/]*
		respond @staging_hidden 404
		@staging_manifest path /windows/x86_64/latest.json
		header @staging_manifest Cache-Control "no-cache, max-age=0, must-revalidate"
		@staging_immutable path /windows/x86_64/releases/*
		header @staging_immutable Cache-Control "public, max-age=31536000, immutable"
		@staging_installer path *.exe
		header @staging_installer Content-Disposition "attachment"
		file_server
	}
	@api path /api /api/* /healthz
	handle @api {
		reverse_proxy api:8080
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

http://:8081 {
	respond /healthz "ok" 200
}
